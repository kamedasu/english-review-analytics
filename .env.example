NOTION_API_KEY=
NOTION_PAGE_IDS=
OPENAI_API_KEY=
# Coach + Analytics. Unset/blank preserves the gpt-4.1-mini compatibility default.
OPENAI_MODEL=gpt-6.1-terra
# RAG answers are independent of OPENAI_MODEL.
OPENAI_RAG_MODEL=gpt-4.1-mini
# Keep this unchanged for the existing 1536-dimensional index.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_SUMMARY_RETRY_COUNT=3
DATA_ROOT_DIR=
STORAGE_MODE=local
# Used only when STORAGE_MODE=s3. AWS credentials come from the normal AWS SDK chain.
S3_BUCKET=english-review-analytics-510437263254
S3_PREFIX=data
AWS_REGION=ap-northeast-1
# Optional endpoint for S3-compatible services in development.
S3_ENDPOINT_URL=
